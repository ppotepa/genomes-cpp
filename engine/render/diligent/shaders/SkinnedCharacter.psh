struct PSInput {
    float4 Position:SV_POSITION;
    float3 Normal:NORMAL0;
    float4 Color:COLOR0;
    float3 WorldPosition:TEXCOORD0;
    float2 UV:TEXCOORD1;
    nointerpolation uint MaterialRegion:TEXCOORD2;
    float Weight:TEXCOORD3;
};
float4 main(PSInput input):SV_TARGET {
    if (ObjectPositionScale.w>=0) {
        float w=saturate(input.Weight);
        return float4(w,0.15+0.65*(1-abs(2*w-1)),1-w,1);
    }
    float roughness=0.72, specular=0.08;
    switch (input.MaterialRegion) {
        case 0: case 11: case 14: roughness=0.90; specular=0.025; break;
        case 4: roughness=0.62; specular=0.08; break;
        case 5: case 6: case 7: roughness=0.12; specular=0.32; break;
        case 13: case 15: roughness=0.65; specular=0.07; break;
        case 16: roughness=0.32; specular=0.35; break;
        case 17: roughness=0.60; specular=0.10; break;
        default: break;
    }
    // Vertex colors already carry resolved skin/hair/iris/equipment identity.
    // Do not tint them a second time by hard-coded brown/green material colors.
    float3 base=max(input.Color.rgb,0.0);
    if (input.MaterialRegion==0 || input.MaterialRegion==11 || input.MaterialRegion==14) {
        float2 frequency=float2(140,180);
        float footprint=max(length(ddx(input.UV*frequency)),length(ddy(input.UV*frequency)));
        float weave=sin(input.UV.x*frequency.x)*sin(input.UV.y*frequency.y);
        base*=1.0+0.025*weave*(1.0-saturate(footprint));
    }
    float3 lit=characterLight(base,safeNormal(input.Normal),input.WorldPosition,roughness,specular);
    return float4(characterToneMap(lit),input.Color.a);
}
