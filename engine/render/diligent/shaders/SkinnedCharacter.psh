Texture2D<float> g_ShadowMap;
SamplerComparisonState g_ShadowMap_sampler;
static const float PI=3.141592653589793;
float shadowVisibility(float3 world,float3 normal) {
    if(ShadowParameters.z<0.5 || MaterialFlags.w==0)return 1;
    float4 q=mul(ShadowUVProjection,float4(world,1));
    float3 uvz=q.xyz/q.w;
    if(any(uvz.xy<0)||any(uvz.xy>1)||uvz.z<=0||uvz.z>=1)return 1;
    float bias=ShadowParameters.x*(1+2*(1-saturate(dot(normal,safeNormal(KeyDirectionIntensity.xyz)))));
    float value=0;
    [unroll]for(int y=-1;y<=1;++y)[unroll]for(int x=-1;x<=1;++x)
        value+=g_ShadowMap.SampleCmpLevelZero(g_ShadowMap_sampler,uvz.xy+float2(x,y)*ShadowParameters.y,uvz.z-bias);
    return value/9;
}
float3 directBRDF(float3 base,float metallic,float roughness,float3 n,float3 v,float3 l,float3 irradiance) {
    float nv=max(dot(n,v),1e-4),nl=saturate(dot(n,l));
    float3 h=safeNormal(l+v);float nh=saturate(dot(n,h)),vh=saturate(dot(v,h));
    float a=roughness*roughness,a2=a*a;
    float d=a2/(PI*pow(nh*nh*(a2-1)+1,2));
    float k=pow(roughness+1,2)/8;
    float g=(nv/(nv*(1-k)+k))*(nl/(nl*(1-k)+k));
    float3 f0=lerp(float3(.04,.04,.04),base,metallic);
    float3 f=f0+(1-f0)*pow(1-vh,5);
    float3 diffuse=(1-f)*(1-metallic)*base/PI;
    return (diffuse+d*g*f/max(4*nv*nl,1e-4))*irradiance*nl;
}
float3 toneMap(float3 x) { x=max(x,0);return saturate(x*(2.51*x+.03)/(x*(2.43*x+.59)+.14)); }
float4 main(SurfacePixel p,bool front:SV_IsFrontFace):SV_TARGET {
    float alpha=surfaceAlpha(p);
    if(MaterialFlags.z==1)clip(alpha-MaterialFactors.w);
    if(p.Weight>=0)return float4(lerp(float3(.03,.10,.75),float3(1,.05,.01),saturate(p.Weight)),1);
    float3 n=safeNormal(p.Normal);if(!front)n=-n;
    float3 base=max(surfaceColor(p).rgb,0),v=safeNormal(SceneCameraPosition.xyz-p.WorldPosition);
    float roughness=clamp(MaterialFactors.x,.045,1),metallic=saturate(MaterialFactors.y);
    float3 ambient=lerp(HemisphereGround.rgb*HemisphereGround.a,HemisphereSky.rgb*HemisphereSky.a,n.y*.5+.5);
    float3 light=ambient*base*(1-metallic);
    light+=directBRDF(base,metallic,roughness,n,v,safeNormal(KeyDirectionIntensity.xyz),
        KeyColor.rgb*KeyDirectionIntensity.w*shadowVisibility(p.WorldPosition,n));
    light+=directBRDF(base,metallic,roughness,n,v,safeNormal(FillDirectionIntensity.xyz),FillColor.rgb*FillDirectionIntensity.w);
    // sRGB render target performs display encoding once. This pass is direct-light PBR,
    // not an IBL/HDR postprocessing implementation.
    return float4(toneMap(light),alpha);
}
