<?xml version="1.0"?>
<rml>
  <head>
    <title>Building laboratory</title>
    <link type="text/rcss" href="ui/theme.rcss"/>
    <link type="text/rcss" href="screen.rcss"/>
  </head>
  <body>
    <main>
      <section class="panel" data-model="ui_builtin_building_lab">
        <header class="screen-header">
          <p class="eyebrow">PROCEDURAL ASSET INSPECTOR</p>
          <h1>Building lab</h1>
          <p class="subtitle">{{ selected }}</p>
          <span class="app-fps">{{ fps }}</span>
        </header>
        <label class="field">
          <span class="field-label">Selected part</span>
          <select class="field-control" data-value="selected_part" data-field="selected_part" data-control="building.select">
            <option data-for="part : parts_options" data-attr-value="part.value">{{ part.label }}</option>
          </select>
        </label>
        <section class="integrity">
          <div class="integrity-label">
            <span>Structural integrity</span>
            <span class="status">LIVE</span>
          </div>
          <progress value="0" max="1" data-value="integrity"/>
        </section>
        <div class="metric-list">
          <div class="metric">
            <span class="metric-name">Parts</span>
            <span class="metric-value">{{ parts }}</span>
          </div>
          <div class="metric">
            <span class="metric-name">Rooms</span>
            <span class="metric-value">{{ rooms }}</span>
          </div>
        </div>
        <div class="divider"/>
        <h3>DAMAGE TEST</h3>
        <label class="field">
          <span class="field-label">Damage amount</span>
          <div class="range-row">
            <input type="range" min="0" max="1" step="0.05" data-value="damage_amount" data-field="damage_amount" data-control="building.damage"/>
            <output>{{ damage_amount }}</output>
          </div>
        </label>
        <button class="danger full" data-action="building.apply-damage">Apply damage</button>
        <div class="command-bar">
          <button class="ghost" data-action="scene.return-main-menu">Back</button>
          <button data-action="building.select-next">Next part</button>
          <button class="primary" data-action="building.regenerate">Regenerate</button>
        </div>
      </section>
    </main>
  </body>
</rml>
