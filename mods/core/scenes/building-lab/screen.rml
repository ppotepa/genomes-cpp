<rml><head><title>Building laboratory</title><link type="text/rcss" href="ui/theme.rcss" /><link type="text/rcss" href="screen.rcss" /></head><body>
<section class="panel" data-model="ui_builtin_building_lab">
  <header class="screen-header"><p class="eyebrow">PROCEDURAL ASSET INSPECTOR</p><h1>Building lab</h1><p class="subtitle" data-bind="text: selected">No building selected.</p></header>
  <label class="field"><span class="field-label">SELECTED PART</span><select class="field-control" data-value="selected_part" data-field="selected_part" data-control="building.select"><option data-for="part : parts_options" data-value="part.value">{{ part.label }}</option></select></label>
  <section class="integrity"><div class="integrity-label"><span>Structural integrity</span><span class="status">LIVE</span></div><progress value="0" max="1" data-value="integrity"></progress></section>
  <div class="metric-list"><div class="metric"><span class="metric-name">Parts</span><span class="metric-value" data-bind="text: parts"></span></div><div class="metric"><span class="metric-name">Rooms</span><span class="metric-value" data-bind="text: rooms"></span></div></div>
  <div class="divider"></div><h3>DAMAGE TEST</h3>
  <label class="field"><span class="field-label">DAMAGE AMOUNT</span><div class="range-row"><input type="range" min="0" max="1" step="0.05" data-value="damage_amount" data-field="damage_amount" data-control="building.damage" /><output data-bind="text: damage_amount"></output></div></label>
  <button class="danger full" data-action="building.apply-damage">Apply damage</button>
  <div class="command-bar"><button class="ghost" data-action="scene.return-main-menu">Back</button><button data-action="building.select-next">Next part</button><button class="primary" data-action="building.regenerate">Regenerate</button></div>
</section></body></rml>
