body { pointer-events: none; width: 100%; height: 100%; overflow: hidden; background-color: transparent; }
main { width: 100%; height: 100%; overflow: hidden; }
.panel { pointer-events: auto; width: 430dp; height: 100%; min-height: 0dp; max-height: 100%; padding: 24dp; border-width: 0dp 1dp 0dp 0dp; overflow-y: auto; }
.integrity { margin-bottom: 18dp; }
.integrity-label { display: flex; margin-bottom: 8dp; color: #9eb0c3; font-size: 12dp; }
.integrity-label span:first-child { flex: 1; }
.full { width: 100%; margin-left: 0dp; }
.command-bar { flex-wrap: wrap; }
