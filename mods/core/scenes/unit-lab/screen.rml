<?xml version="1.0"?>
<rml>
  <head>
    <title>Unit Lab</title>
    <link type="text/rcss" href="ui/theme.rcss"/>
    <link type="text/rcss" href="screen.rcss"/>
  </head>
  <body data-model="ui_builtin_unit_lab">
    <div class="unit-shell">
      <header id="unit-header" class="unit-topbar">
        <div class="brand">GENOMES <span>/ UNIT LAB</span></div>
        <div class="title">Infantry generator</div>
        <span class="app-fps">{{ fps }}</span>
        <button class="icon ghost" data-action="unit.back" aria-label="Close Unit Lab">&#xD7;</button>
      </header>
      <div class="unit-workspace">
        <nav id="unit-rail" class="unit-rail" aria-label="Laboratories">
          <button class="active">INF</button>
          <button disabled="disabled">VEH</button>
          <button data-action="scene.open-building-lab">BLD</button>
          <button data-action="scene.open-world-lab">WLD</button>
        </nav>
        <div class="unit-content">
          <section id="unit-toolbar" class="unit-toolbar" aria-label="Quick operations">
            <label class="toolbar-field">
              <span>Seed</span>
              <input type="number" data-value="seed" data-field="seed" data-control="unit.seed"/>
            </label>
            <button class="primary" data-action="unit.regenerate">Regenerate</button>
            <label class="toolbar-field">
              <span>Side</span>
              <select data-value="side" data-field="side" data-control="unit.side">
                <option value="Side A">Side A</option>
                <option value="Side B">Side B</option>
                <option value="Neutral">Neutral</option>
              </select>
            </label>
            <span class="status-chip">{{ status_compact }}</span>
          </section>
          <div class="alert" data-if="error">
            <strong>Generation failed</strong>
            <span>{{ error }}</span>
          </div>
          <div class="unit-stage">
            <div class="unit-viewport-frame">
              <main id="unit-viewport" class="unit-viewport" aria-label="Infantry viewport"/>
              <footer id="unit-caption" class="unit-caption">LMB ORBIT <span>RMB / MMB PAN</span><span>WHEEL ZOOM</span><span>R RESET</span></footer>
            </div>
            <aside id="unit-inspector" class="unit-inspector" aria-label="Infantry inspector">
              <nav class="tabs unit-tabs" aria-label="Inspector sections">
                <button data-control="unit.tab" data-key="model" value="model" data-class-active="tab_model">Model</button>
                <button data-control="unit.tab" data-key="equipment" value="equipment" data-class-active="tab_equipment">Equipment</button>
                <button data-control="unit.tab" data-key="genome" value="genome" data-class-active="tab_genome">Genome</button>
                <button data-control="unit.tab" data-key="skeleton" value="skeleton" data-class-active="tab_skeleton">Skeleton</button>
                <button data-control="unit.tab" data-key="animation" value="animation" data-class-active="tab_animation">Animation</button>
                <button data-control="unit.tab" data-key="face" value="face" data-class-active="tab_face">Face</button>
              </nav>
              <div class="unit-inspector-scroll">
                <section data-if="tab_model">
                  <h2>Model</h2>
                  <details class="disclosure" open="open">
                    <summary>
                      <button type="button" data-disclosure="toggle" aria-expanded="true">Quality and camera</button>
                    </summary>
                    <div class="disclosure-body">
                      <label class="field">
                        <span class="field-label">Detail</span>
                        <select class="field-control" data-field="detail" data-control="unit.detail">
                          <option value="1">Far</option>
                          <option value="2">World</option>
                          <option value="3">High</option>
                        </select>
                      </label>
                      <label class="field">
                        <span class="field-label">Camera preset</span>
                        <select class="field-control" data-value="camera" data-control="unit.camera">
                          <option value="Three quarter">Three quarter</option>
                          <option value="Front">Front</option>
                          <option value="Side">Side</option>
                          <option value="Back">Back</option>
                          <option value="Face">Face</option>
                          <option value="Hands">Hands</option>
                        </select>
                      </label>
                      <button class="wide ghost" data-action="unit.camera-reset">Reset view</button>
                      <label class="check-row"><input type="checkbox" data-checked="auto_rotate" data-field="auto_rotate" data-control="unit.auto-rotate"/> Auto-rotate</label>
                    </div>
                  </details>
                  <details class="disclosure" open="open">
                    <summary>
                      <button type="button" data-disclosure="toggle" aria-expanded="true">Appearance</button>
                    </summary>
                    <div class="disclosure-body">
                      <label class="field">
                        <span class="field-label">Preset</span>
                        <select class="field-control" data-value="appearance_preset" data-control="unit.appearance-preset">
                          <option value="inspection-olive">Inspection olive</option>
                        </select>
                      </label>
                    </div>
                  </details>
                  <details class="disclosure">
                    <summary>
                      <button type="button" data-disclosure="toggle" aria-expanded="false">Rendering and debug</button>
                    </summary>
                    <div class="disclosure-body" style="display: none;">
                      <label class="check-row"><input type="checkbox" data-checked="surface" data-field="surface" data-control="unit.surface"/> Surface</label>
                      <label class="check-row"><input type="checkbox" data-checked="wireframe" data-field="wireframe" data-control="unit.wireframe"/> Wireframe</label>
                      <label class="check-row"><input type="checkbox" data-checked="bounds" data-field="bounds" data-control="unit.bounds"/> Bounds</label>
                      <label class="check-row"><input type="checkbox" data-checked="normals" data-field="normals" data-control="unit.normals"/> Normals</label>
                    </div>
                  </details>
                </section>
                <section data-if="tab_equipment">
                  <h2>Equipment</h2>
                  <details class="disclosure" open="open">
                    <summary>
                      <button type="button" data-disclosure="toggle" aria-expanded="true">Loadout</button>
                    </summary>
                    <div class="disclosure-body">
                      <label class="field">
                        <span class="field-label">Loadout</span>
                        <select class="field-control" data-control="unit.loadout-select">
                          <option data-for="item : loadouts" data-attr-value="item.value" data-attrif-selected="item.selected">{{ item.label }}</option>
                        </select>
                      </label>
                      <label class="field">
                        <span class="field-label">Palette</span>
                          <select class="field-control" data-value="palette" data-control="unit.palette">
                          <option value="Standard">Standard</option>
                          <option value="Forest">Forest</option>
                          <option value="Field">Field</option>
                          <option value="Night">Night</option>
                        </select>
                      </label>
                      <label class="field">
                        <span class="field-label">Wear</span>
                        <div class="range-row">
                          <input type="range" min="0" max="1" step="0.05" data-value="wear" data-field="wear" data-control="unit.wear"/>
                          <output>{{ wear }}</output>
                        </div>
                      </label>
                      <p class="readout">Equipment seed <output>{{ equipment_seed }}</output></p>
                      <button class="wide ghost" data-action="unit.equipment-clear">Reset equipment</button>
                    </div>
                  </details>
                  <details class="disclosure">
                    <summary>
                      <button type="button" data-disclosure="toggle" aria-expanded="false">Apparel, armor, attachments and weapons</button>
                    </summary>
                    <div class="disclosure-body" style="display: none;">
                      <div class="list-row" data-for="slot : equipment_slots">
                        <label class="field">
                          <span class="field-label">{{ slot.group }} / {{ slot.label }}</span>
                          <select class="field-control" data-control="unit.equipment-item" data-attr-data-key="slot.id">
                            <option data-for="item : equipment_items" data-if="item.group == slot.id" data-attr-value="item.value" data-attrif-selected="item.selected">{{ item.label }}</option>
                          </select>
                        </label>
                      </div>
                    </div>
                  </details>
                </section>
                <section data-if="tab_genome">
                  <h2>Genome</h2>
                  <details class="disclosure" open="open">
                    <summary>
                      <button type="button" data-disclosure="toggle" aria-expanded="true">Variation and presets</button>
                    </summary>
                    <div class="disclosure-body">
                      <label class="field">
                        <span class="field-label">Variation</span>
                        <div class="range-row">
                          <input type="range" min="0" max="1.75" step="0.05" data-value="variation" data-field="variation" data-control="unit.variation"/>
                          <output>{{ variation }}</output>
                        </div>
                      </label>
                      <div class="preset-row">
                        <button data-action="unit.genome-reset">Seed</button>
                        <button data-control="unit.genome-preset" value="short">Short</button>
                        <button data-control="unit.genome-preset" value="tall">Tall</button>
                        <button data-control="unit.genome-preset" value="broad">Broad</button>
                      </div>
                      <button class="wide ghost" data-action="unit.genome-reset">Reset all overrides</button>
                    </div>
                  </details>
                  <details class="disclosure">
                    <summary>
                      <button type="button" data-disclosure="toggle" aria-expanded="false">Root, body and face genes</button>
                    </summary>
                    <div class="disclosure-body" style="display: none;">
                      <div class="gene" data-for="gene : genes">
                        <div class="gene-heading">
                          <span>{{ gene.group }} / {{ gene.label }}</span>
                          <span class="override" data-if="gene.overridden">OVERRIDE</span>
                        </div>
                        <div class="range-row">
                          <input type="range" min="0" max="1" step="0.01" data-value="gene.number_value" data-control="unit.genome" data-attr-data-field="gene.id" data-attr-data-key="gene.id"/>
                          <output>{{ gene.value }}</output>
                          <button class="icon ghost" data-control="unit.genome-clear" data-attr-data-key="gene.id" aria-label="Clear override">&#x21BA;</button>
                        </div>
                      </div>
                    </div>
                  </details>
                </section>
                <section data-if="tab_skeleton">
                  <h2>Skeleton</h2>
                  <details class="disclosure" open="open">
                    <summary>
                      <button type="button" data-disclosure="toggle" aria-expanded="true">Display and weights</button>
                    </summary>
                    <div class="disclosure-body">
                      <label class="check-row"><input type="checkbox" data-checked="skeleton" data-field="skeleton" data-control="unit.skeleton"/> Draw bones</label>
                      <label class="field">
                        <span class="field-label">Weight heatmap</span>
                        <select class="field-control" data-control="unit.weight">
                          <option value="off">Off</option>
                          <option data-for="bone : bones" data-attr-value="bone.id" data-attrif-selected="bone.selected">{{ bone.label }}</option>
                        </select>
                      </label>
                      <p class="readout">{{ ragdoll_readout }}</p>
                    </div>
                  </details>
                  <details class="disclosure">
                    <summary>
                      <button type="button" data-disclosure="toggle" aria-expanded="false">Rig hierarchy</button>
                    </summary>
                    <div class="disclosure-body" style="display: none;">
                      <div class="bone" data-for="bone : bones">
                        <span>{{ bone.label }}</span>
                        <span>{{ bone.value }}</span>
                      </div>
                    </div>
                  </details>
                </section>
                <section data-if="tab_animation">
                  <h2>Animation</h2>
                  <label class="field">
                    <span class="field-label">State</span>
                    <select class="field-control" data-value="locomotion" data-control="unit.locomotion">
                      <option value="Idle">Idle</option>
                      <option value="Walk">Walk</option>
                      <option value="Run">Run</option>
                      <option value="Crouch">Crouch</option>
                      <option value="Crouch Walk">Crouch Walk</option>
                      <option value="REST">Rest</option>
                      <option value="SITTING">Sitting</option>
                      <option value="PRONE">Prone</option>
                      <option value="PRONE_MOVE">Prone move</option>
                    </select>
                  </label>
                  <label class="field">
                    <span class="field-label">Locomotion speed (m/s)</span>
                    <div class="range-row">
                      <input type="range" min="0" max="5" step="0.01" data-value="locomotion_speed" data-field="locomotion_speed" data-control="unit.locomotion-speed"/>
                      <output>{{ locomotion_speed }}</output>
                    </div>
                  </label>
                  <label class="field">
                    <span class="field-label">Crouch</span>
                    <div class="range-row">
                      <input type="range" min="0" max="1" step="0.01" data-value="locomotion_crouch" data-field="locomotion_crouch" data-control="unit.locomotion-crouch"/>
                      <output>{{ locomotion_crouch }}</output>
                    </div>
                  </label>
                  <label class="field">
                    <span class="field-label">Transition seconds</span>
                    <div class="range-row">
                      <input type="range" min="0" max="1.5" step="0.01" data-value="animation_transition_seconds" data-field="animation_transition_seconds" data-control="unit.animation-transition"/>
                      <output>{{ animation_transition_seconds }}</output>
                    </div>
                    <small class="field-hint">All staged transitions; seek/reset snaps the preview.</small>
                  </label>
                  <label class="field">
                    <span class="field-label">Playback speed</span>
                    <div class="range-row">
                      <input type="range" min="0" max="2" step="0.05" data-value="animation_speed" data-field="animation_speed" data-control="unit.animation-speed"/>
                      <output>{{ animation_speed }}</output>
                    </div>
                  </label>
                  <dl class="readout">
                    <div><dt>Requested crouch/speed</dt><dd>{{ locomotion_requested_crouch }} / {{ locomotion_requested_speed }}</dd></div>
                    <div><dt>Actual crouch/speed</dt><dd>{{ locomotion_actual_crouch }} / {{ locomotion_actual_speed }}</dd></div>
                    <div><dt>Run/sprint blend</dt><dd>{{ locomotion_run_weight }} / {{ locomotion_sprint_weight }}</dd></div>
                    <div><dt>Transition stage / total / local</dt><dd>{{ locomotion_transition_stage }} / {{ locomotion_transition_progress }} / {{ locomotion_transition_stage_progress }}</dd></div>
                  </dl>
                  <label class="field">
                    <span class="field-label">Phase</span>
                    <div class="range-row">
                      <input type="range" min="0" max="0.99" step="0.01" data-value="animation_phase" data-field="animation_phase" data-control="unit.phase"/>
                      <output>{{ animation_phase }}</output>
                    </div>
                  </label>
                  <p class="hint">Scrubbing phase pauses playback.</p>
                  <div class="player-controls" aria-label="Animation player">
                    <button class="icon ghost" data-action="unit.animation-step-back" aria-label="Previous frame">&#x23EE;</button>
                    <button class="icon ghost" data-action="unit.animation-reset" aria-label="Reset animation">&#x25C0;</button>
                    <button class="icon ghost" data-action="unit.animation-step-forward" aria-label="Next frame">&#x23ED;</button>
                  </div>
                  <button class="wide primary" data-action="unit.pause">{{ pause_label }}</button>
                </section>
                <section data-if="tab_face">
                  <h2>Face</h2>
                  <label class="field">
                    <span class="field-label">Expression</span>
                    <select class="field-control" data-value="expression" data-control="unit.expression">
                      <option value="Neutral">Neutral</option>
                      <option value="Alert">Alert</option>
                      <option value="Fear">Fear</option>
                      <option value="Anger">Anger</option>
                      <option value="Pain">Pain</option>
                      <option value="Fatigue">Fatigue</option>
                      <option value="Eyes closed">Eyes closed</option>
                    </select>
                  </label>
                  <label class="field">
                    <span class="field-label">Intensity</span>
                    <div class="range-row">
                      <input type="range" min="0" max="1" step="0.05" data-value="expression_intensity" data-field="expression_intensity" data-control="unit.expression-intensity" data-attrif-disabled="!expression_intensity_enabled"/>
                      <output>{{ expression_intensity }}</output>
                    </div>
                  </label>
                </section>
                <details class="disclosure diagnostics">
                  <summary>
                    <button type="button" data-disclosure="toggle" aria-expanded="false">Diagnostics</button>
                  </summary>
                  <div class="disclosure-body" style="display: none;">
                    <p class="readout wrap">{{ metrics }}</p>
                  </div>
                </details>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </div>
  </body>
</rml>
