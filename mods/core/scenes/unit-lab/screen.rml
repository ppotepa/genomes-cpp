<rml><head><title>Unit Lab</title><link type="text/rcss" href="ui/theme.rcss" /><link type="text/rcss" href="screen.rcss" /></head>
<body data-model="ui_builtin_unit_lab">
<header id="unit-header" class="unit-topbar"><div class="brand">GENOMES <span>/ UNIT LAB</span></div><div class="title">Infantry generator</div><button class="icon ghost" data-action="unit.back">&#215;</button></header>
<nav id="unit-rail" class="unit-rail"><button class="active">INF</button><button disabled="disabled">VEH</button><button data-action="scene.open-building-lab">BLD</button><button data-action="scene.open-world-lab">WLD</button></nav>
<section id="unit-toolbar" class="unit-toolbar"><label>SEED<input type="number" data-value="seed" data-field="seed" data-control="unit.seed" /></label><button data-action="unit.regenerate">NEXT SEED</button><label>SIDE<select data-field="side" data-control="unit.side"><option>Side A</option><option>Side B</option><option>Neutral</option></select></label><span class="status-chip" data-bind="text: status_compact">Updating</span></section>
<div class="alert" data-if="error"><strong>Generation failed</strong><span data-bind="text: error"></span></div>
<aside id="unit-inspector" class="unit-inspector"><nav class="tabs unit-tabs"><button data-control="unit.tab" data-key="model" value="model" data-class-active="tab_model">MODEL</button><button data-control="unit.tab" data-key="equipment" value="equipment" data-class-active="tab_equipment">EQUIPMENT</button><button data-control="unit.tab" data-key="genome" value="genome" data-class-active="tab_genome">GENOME</button><button data-control="unit.tab" data-key="skeleton" value="skeleton" data-class-active="tab_skeleton">SKELETON</button><button data-control="unit.tab" data-key="animation" value="animation" data-class-active="tab_animation">ANIMATION</button><button data-control="unit.tab" data-key="face" value="face" data-class-active="tab_face">FACE</button></nav><main class="unit-inspector-scroll">
<section data-if="tab_model"><h2>Model</h2><details open="open"><summary>Quality and camera</summary><label class="field"><span class="field-label">DETAIL</span><select class="field-control" data-field="detail" data-control="unit.detail"><option value="1">Far</option><option value="2">World</option><option value="3">High</option></select></label><label class="field"><span class="field-label">CAMERA PRESET</span><select class="field-control" data-control="unit.camera"><option>Three quarter</option><option>Front</option><option>Side</option><option>Back</option><option>Face</option><option>Hands</option></select></label><button class="wide ghost" data-action="unit.camera-reset">RESET VIEW</button><label class="check-row"><input type="checkbox" data-checked="auto_rotate" data-field="auto_rotate" data-control="unit.auto-rotate" /> Auto-rotate</label></details><details open="open"><summary>Rendering and debug</summary><label class="check-row"><input type="checkbox" data-checked="surface" data-field="surface" data-control="unit.surface" /> Surface</label><label class="check-row"><input type="checkbox" data-checked="wireframe" data-field="wireframe" data-control="unit.wireframe" /> Wireframe</label><label class="check-row"><input type="checkbox" data-checked="bounds" data-field="bounds" data-control="unit.bounds" /> Bounds</label><label class="check-row"><input type="checkbox" data-checked="normals" data-field="normals" data-control="unit.normals" /> Normals</label></details></section>
<section data-if="tab_equipment"><h2>Equipment</h2><details open="open"><summary>Loadout</summary><label class="field"><span class="field-label">LOADOUT</span><select class="field-control" data-control="unit.loadout-select"><option data-for="item : loadouts" data-attr-value="item.value" data-attr-selected="item.selected">{{ item.label }}</option></select></label><label class="field"><span class="field-label">PALETTE</span><select class="field-control" data-control="unit.palette"><option>Standard</option><option>Forest</option><option>Field</option><option>Night</option></select></label><label class="field"><span class="field-label">WEAR</span><div class="range-row"><input type="range" min="0" max="1" step="0.05" data-value="wear" data-field="wear" data-control="unit.wear" /><output data-bind="text: wear"></output></div></label><p class="readout">Equipment seed <span data-bind="text: equipment_seed"></span></p><button class="wide ghost" data-action="unit.equipment-clear">RESET EQUIPMENT</button></details><details open="open"><summary>Apparel, armor, attachments and weapons</summary><div class="list-row" data-for="slot : equipment_slots"><label class="field"><span class="field-label">{{ slot.group }} / {{ slot.label }}</span><select class="field-control" data-control="unit.equipment-item" data-attr-data-key="slot.id"><option data-for="item : equipment_items" data-if="item.group == slot.id" data-attr-value="item.value" data-attr-selected="item.selected">{{ item.label }}</option></select></label></div></details></section>
<section data-if="tab_genome"><h2>Genome</h2><details open="open"><summary>Variation and presets</summary><label class="field"><span class="field-label">VARIATION</span><div class="range-row"><input type="range" min="0" max="1.75" step="0.05" data-value="variation" data-field="variation" data-control="unit.variation" /><output data-bind="text: variation"></output></div></label><div class="preset-row"><button data-action="unit.genome-reset">SEED</button><button data-control="unit.genome-preset" data-value="short">SHORT</button><button data-control="unit.genome-preset" data-value="tall">TALL</button><button data-control="unit.genome-preset" data-value="broad">BROAD</button></div><button class="wide ghost" data-action="unit.genome-reset">RESET ALL OVERRIDES</button></details><details open="open"><summary>Root, body and face genes</summary><div class="gene" data-for="gene : genes"><div class="gene-heading"><span>{{ gene.group }} / {{ gene.label }}</span><span class="override" data-if="gene.overridden">OVERRIDE</span></div><div class="range-row"><input type="range" min="0" max="1" step="0.01" data-value="gene.number_value" data-control="unit.genome" data-attr-data-field="gene.id" data-attr-data-key="gene.id" /><output>{{ gene.value }}</output><button class="icon ghost" data-control="unit.genome-clear" data-attr-data-key="gene.id">&#8634;</button></div></div></details></section>
<section data-if="tab_skeleton"><h2>Skeleton</h2><label class="check-row"><input type="checkbox" data-checked="skeleton" data-field="skeleton" data-control="unit.skeleton" /> Draw bones</label><label class="field"><span class="field-label">WEIGHT HEATMAP</span><select class="field-control" data-control="unit.weight"><option value="off">Off</option><option data-for="bone : bones" data-attr-value="bone.id" data-attr-selected="bone.selected">{{ bone.label }}</option></select></label><p class="readout" data-bind="text: ragdoll_readout"></p><details open="open"><summary>Rig hierarchy</summary><div class="bone" data-for="bone : bones"><span>{{ bone.label }}</span><span>{{ bone.value }}</span></div></details></section>
<section data-if="tab_animation"><h2>Animation</h2><label class="field"><span class="field-label">STATE</span><select class="field-control" data-control="unit.locomotion"><option>Idle</option><option>Walk</option><option>Run</option><option>Crouch</option><option>Crouch Walk</option></select></label><label class="field"><span class="field-label">SPEED</span><div class="range-row"><input type="range" min="0" max="2" step="0.05" data-value="animation_speed" data-field="animation_speed" data-control="unit.animation-speed" /><output data-bind="text: animation_speed"></output></div></label><label class="field"><span class="field-label">PHASE</span><div class="range-row"><input type="range" min="0" max="1" step="0.01" data-value="animation_phase" data-field="animation_phase" data-control="unit.phase" /><output data-bind="text: animation_phase"></output></div></label><p class="hint">Scrubbing phase pauses playback.</p><button class="wide primary" data-action="unit.pause" data-bind="text: pause_label">Pause</button></section>
<section data-if="tab_face"><h2>Face</h2><label class="field"><span class="field-label">EXPRESSION</span><select class="field-control" data-control="unit.expression"><option>Neutral</option><option>Alert</option><option>Fear</option><option>Anger</option><option>Pain</option><option>Fatigue</option><option>Eyes closed</option></select></label><label class="field"><span class="field-label">INTENSITY</span><div class="range-row"><input type="range" min="0" max="1" step="0.05" data-value="expression_intensity" data-field="expression_intensity" data-control="unit.expression-intensity" data-attr-disabled="!expression_intensity_enabled" /><output data-bind="text: expression_intensity"></output></div></label></section>
<details class="diagnostics"><summary>Diagnostics</summary><p class="readout wrap" data-bind="text: metrics"></p></details></main></aside><footer id="unit-caption" class="unit-caption">LMB ORBIT <span>RMB / MMB PAN</span><span>WHEEL ZOOM</span><span>R RESET</span></footer>
</body></rml>
