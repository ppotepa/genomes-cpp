body {
  background-color: transparent;
  color: #d5e2f2;
  font-family: LatoLatin;
}
.panel {
  width: 420px;
  height: 92%;
  margin: 24px;
  padding: 20px;
  background-color: rgba(8, 16, 28, 220);
  border: 1px #263b54;
  overflow-y: auto;
}
h1 { margin-bottom: 4px; color: #f0f5fb; }
.hint { margin-top: 0px; margin-bottom: 14px; color: #8fa5bd; }
.controls { width: 100%; }
button {
  display: block;
  width: 100%;
  height: 38px;
  margin-bottom: 6px;
  padding: 8px 12px;
  background-color: #122238;
  border: 1px #294563;
  color: #d5e2f2;
}
button:hover { background-color: #1b3858; }
button:active { background-color: #24517e; }
.back { margin-top: 12px; background-color: #39212a; border-color: #69404d; }
