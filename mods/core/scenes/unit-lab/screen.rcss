/* Unit Lab placement. Reusable controls and their states belong to ui/theme.rcss. */
body { width: 100%; height: 100%; margin: 0dp; overflow: hidden; pointer-events: none; background-color: transparent; }
.unit-shell { display: flex; flex-direction: column; width: 100%; height: 100%; min-width: 0dp; min-height: 0dp; }
.unit-topbar { box-sizing: border-box; pointer-events: auto; display: flex; flex: 0 0 46dp; align-items: center; gap: 12dp; width: 100%; padding: 0dp 12dp; background-color: #181c24; border-bottom: 1dp #303641; }
.brand { flex: 0 0 188dp; color: #a9c7ff; font-size: 13dp; }
.brand span { color: #aab5c4; }
.title { flex: 1; min-width: 0dp; font-size: 14dp; }
.unit-topbar button { flex: 0 0 32dp; padding: 0dp; }
.unit-topbar .app-fps { margin-left: auto; }
.unit-workspace { display: flex; flex: 1 1 auto; height: 0dp; min-width: 0dp; min-height: 0dp; }
.unit-rail { box-sizing: border-box; pointer-events: auto; display: flex; flex: 0 0 52dp; flex-direction: column; width: 52dp; min-height: 0dp; background-color: #181c24; border-right: 1dp #303641; }
.unit-rail button { flex: 0 0 44dp; width: 44dp; height: 44dp; margin: 4dp; padding: 0dp; font-size: 12dp; }
.unit-content { display: flex; flex: 1 1 auto; flex-direction: column; min-width: 0dp; min-height: 0dp; }
.unit-toolbar { box-sizing: border-box; pointer-events: auto; position: relative; display: flex; flex: 0 0 44dp; align-items: center; gap: 8dp; width: 100%; min-width: 0dp; padding: 5dp 10dp; background-color: #181c24; border-bottom: 1dp #303641; }
.toolbar-field { display: flex; align-items: center; gap: 8dp; font-size: 13dp; }
.toolbar-field input, .toolbar-field select { flex: 0 0 112dp; width: 112dp; }
.unit-toolbar > button { flex: 0 0 auto; }
.unit-toolbar .status-chip { flex: 0 0 auto; margin-left: auto; }
.unit-stage { display: flex; flex: 1 1 auto; height: 0dp; min-width: 0dp; min-height: 0dp; }
.unit-viewport-frame { display: flex; flex: 1 1 auto; flex-direction: column; min-width: 0dp; min-height: 0dp; }
.unit-viewport { pointer-events: none; display: block; flex: 1 1 auto; min-width: 0dp; min-height: 0dp; background-color: transparent; }
.unit-caption { box-sizing: border-box; display: flex; flex: 0 0 28dp; align-items: center; gap: 12dp; min-width: 0dp; padding: 0dp 12dp; overflow: hidden; color: #aab5c4; background-color: #181c24; font-size: 11dp; white-space: nowrap; }
.unit-inspector { box-sizing: border-box; pointer-events: auto; display: flex; flex: 0 0 360dp; flex-direction: column; min-width: 336dp; max-width: 380dp; min-height: 0dp; background-color: #181c24; border-left: 1dp #303641; }
.unit-tabs { display: flex; flex: 0 0 60dp; flex-wrap: wrap; align-content: flex-start; width: 100%; overflow: hidden; border: 0dp; }
.unit-tabs button { box-sizing: border-box; flex: 0 0 33.333%; width: 33.333%; min-width: 0dp; height: 30dp; min-height: 30dp; margin: 0dp; padding: 4dp 0dp; font-size: 12dp; }
.unit-inspector-scroll { display: block; flex: 1 1 auto; min-width: 0dp; min-height: 0dp; overflow-y: auto; padding: 10dp 12dp; pointer-events: auto; box-sizing: border-box; }
.unit-inspector-scroll scrollbarvertical { width: 8dp; margin: 2dp; }
.unit-inspector h2 { margin: 4dp 0dp 12dp 0dp; font-size: 16dp; }
.unit-inspector .field-label { flex-basis: 104dp; width: 104dp; }
.unit-inspector .check-row { padding-left: 104dp; }
.unit-inspector .hint { margin-left: 104dp; font-size: 12dp; }
.alert { pointer-events: auto; position: absolute; left: 64dp; top: 122dp; right: 392dp; z-index: 20; }
.alert strong { margin-right: 8dp; }
@media (max-width: 1400dp) {
    .unit-inspector { flex-basis: 336dp; }
    .unit-toolbar { flex-basis: 68dp; align-items: flex-start; padding-top: 4dp; padding-bottom: 4dp; }
    .unit-toolbar .status-chip { position: absolute; right: 10dp; bottom: 2dp; padding-top: 2dp; padding-bottom: 2dp; }
    .alert { right: 348dp; }
}
@media (min-width: 1700dp) {
    .unit-inspector { flex-basis: 380dp; }
    .unit-toolbar { padding-left: 14dp; padding-right: 14dp; }
}
