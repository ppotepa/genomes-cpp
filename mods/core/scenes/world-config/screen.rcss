body { pointer-events: none; width: 100%; height: 100%; overflow: hidden; background-color: transparent; }
main { width: 100%; height: 100%; overflow: hidden; }
.panel { pointer-events: auto; width: 590dp; height: 90%; max-width: 86%; min-height: 0dp; max-height: 90%; margin: 5% 0dp 0dp 56dp; padding: 24dp; overflow-y: auto; }
.command-bar { flex-wrap: wrap; }
.command-bar button { min-width: 120dp; }
