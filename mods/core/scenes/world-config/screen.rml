<?xml version="1.0"?>
<rml>
  <head>
    <title>World configuration</title>
    <link type="text/rcss" href="ui/theme.rcss"/>
    <link type="text/rcss" href="screen.rcss"/>
  </head>
  <body>
    <main>
      <section class="panel" data-model="ui_builtin_world_config">
        <header class="screen-header">
          <p class="eyebrow">NEW SIMULATION</p>
          <h1>World configuration</h1>
          <p class="subtitle">{{ title }}</p>
          <span class="app-fps">{{ fps }}</span>
        </header>
        <label class="field">
          <span class="field-label">Seed</span>
          <input class="field-control" type="number" data-value="seed" data-field="seed" data-control="world.seed"/>
        </label>
        <p class="validation">{{ seed_error }}</p>
        <label class="field">
          <span class="field-label">Map size</span>
          <select class="field-control" data-value="map_size" data-field="map_size" data-control="world.map-size">
            <option data-for="option : map_size_options" data-attr-value="option.value" data-attrif-disabled="!option.enabled" data-attrif-selected="option.selected">{{ option.label }}</option>
          </select>
        </label>
        <div class="divider"/>
        <h3>WORLD COMPOSITION</h3>
        <label class="field">
          <span class="field-label">Vegetation</span>
          <div class="range-row">
            <input type="range" min="0" max="1" step="0.05" data-value="vegetation" data-field="vegetation" data-control="world.vegetation"/>
            <output>{{ vegetation_percent }}</output>
          </div>
        </label>
        <label class="field">
          <span class="field-label">Buildings</span>
          <div class="range-row">
            <input type="range" min="0" max="1" step="0.05" data-value="buildings" data-field="buildings" data-control="world.buildings"/>
            <output>{{ buildings_percent }}</output>
          </div>
        </label>
        <label class="field">
          <span class="field-label">Fenced parcels</span>
          <div class="range-row">
            <input type="range" min="0" max="1" step="0.05" data-value="fenced_parcels" data-field="fenced_parcels" data-control="world.fenced-parcels"/>
            <output>{{ fenced_parcels_percent }}</output>
          </div>
        </label>
        <div class="command-bar">
          <button class="ghost" data-action="scene.return-main-menu">Back</button>
          <button class="primary" data-action="scene.start-battlefield">Start scenario</button>
        </div>
      </section>
    </main>
  </body>
</rml>
