<rml><head><title>Genomes control gallery</title><link type="text/rcss" href="ui/theme.rcss" /><link type="text/rcss" href="ui-test.rcss" /></head><body>
<section class="gallery panel">
  <header class="screen-header"><p class="eyebrow">DESIGN SYSTEM / CONTROL GALLERY</p><h1>Interface foundation</h1><p class="subtitle">Interactive states and reusable patterns for scene UI.</p></header>
  <div class="gallery-grid">
    <section class="gallery-section"><h3>ACTIONS</h3><div class="button-demo"><button class="primary" data-action="scene.start-battlefield">Primary</button><button>Secondary</button><button class="ghost">Ghost</button><button class="danger">Danger</button><button class="icon" aria-label="Icon action">+</button><button disabled="disabled">Disabled</button></div><button class="busy">Working…</button></section>
    <section class="gallery-section"><h3>TEXT AND SELECTION</h3><label class="field"><span class="field-label">DISPLAY NAME</span><input class="field-control" type="text" value="Scout alpha" /></label><label class="field"><span class="field-label">EMPTY VALUE</span><input class="field-control" type="text" placeholder="Optional" /></label><label class="field"><span class="field-label">READ ONLY</span><input class="field-control" type="text" value="Generated asset" readonly="readonly" /></label><label class="field"><span class="field-label">OPEN DROPDOWN STATES</span><select class="field-control" size="5"><option>Hover target</option><option selected="selected">Selected option</option><option disabled="disabled">Disabled option</option><option>Long option label for overflow</option><option>Scrollable option</option><option>Last option</option></select></label></section>
    <section class="gallery-section"><h3>VALUES AND VALIDATION</h3><label class="field"><span class="field-label">COUNT</span><input class="field-control" type="number" value="42" min="0" max="100" /></label><label class="field"><span class="field-label">INVALID VALUE</span><input class="field-control invalid" type="text" value="Out of range" /></label><p class="validation">Enter a value between 0 and 100.</p><label class="field"><span class="field-label">DENSITY</span><div class="range-row"><input type="range" min="0" max="100" value="58" /><output>58%</output></div></label><div class="progress"><div style="width: 65%;"></div></div></section>
    <section class="gallery-section"><h3>TOGGLES</h3><label class="check-row"><input type="checkbox" checked="checked" /> Surface rendering</label><label class="check-row"><input type="checkbox" /> Wireframe overlay</label><label class="check-row"><input type="checkbox" disabled="disabled" /> Unavailable option</label><label class="check-row"><input type="radio" name="gallery-radio" checked="checked" /> Balanced profile</label><label class="check-row"><input type="radio" name="gallery-radio" /> Detailed profile</label></section>
    <section class="gallery-section wide"><h3>COMPOSITE PATTERNS</h3><div class="tabs"><button class="active">Overview</button><button>Parameters</button><button>Diagnostics</button></div><details open="open"><summary>Collapsible section</summary><div class="metric-list"><div class="metric"><span class="metric-name">Frame time</span><span class="metric-value">16.2 ms</span></div><div class="metric"><span class="metric-name">Triangles</span><span class="metric-value">128k</span></div></div></details><div class="file-picker"><input type="text" value="No file selected" readonly="readonly" /><button>Choose file</button></div><p class="prototype-banner">Prototype UI — not applied to simulation</p></section>
  </div>
</section></body></rml>
