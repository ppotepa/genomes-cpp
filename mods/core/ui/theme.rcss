/* Genomes UI foundation. Shared files own visuals; scene RCSS owns placement. */
body, section, header, nav, main, footer, article, aside, h1, h2, h3, p, ul, ol, li { display: block; }
body { color: #e3e7ed; font-family: LatoLatin; font-size: 14dp; line-height: 1.4; }
h1, h2, h3, p { margin-top: 0dp; }
h1 { margin-bottom: 8dp; color: #f0f3f8; font-size: 26dp; font-weight: bold; }
h2 { margin-bottom: 8dp; color: #f1f6fb; font-size: 19dp; }
h3 { margin-bottom: 8dp; color: #bdc6d2; font-size: 13dp; font-weight: bold; }
.surface, .panel, .hud-card { box-sizing: border-box; min-width: 0dp; min-height: 0dp; background-color: #181c24; border: 1dp #303641; }
.panel { display: flex; flex-direction: column; }
.screen-header { position: relative; margin-bottom: 15dp; }
.app-fps { position: static; display: inline-block; padding: 4dp 7dp; color: #9fc7e8; background-color: #111b28; border: 1dp #30465e; font-size: 11dp; font-weight: bold; letter-spacing: 1dp; }
.screen-header .app-fps, .hud-card > header .app-fps { position: absolute; top: 0dp; right: 0dp; }
.eyebrow { margin-bottom: 7dp; color: #6fc8ff; font-size: 11dp; font-weight: bold; letter-spacing: 2dp; }
.subtitle, .hint, .copy, .muted { color: #8fa2b7; }
.subtitle, .hint, .copy { margin-bottom: 0dp; }
.divider { height: 1dp; margin: 11dp 0dp; background-color: #26374a; }

button, input, select { box-sizing: border-box; height: 32dp; min-height: 32dp; min-width: 0dp; margin: 0dp; padding: 5dp 8dp; color: #e3e7ed; background-color: #232933; border: 1dp #414956; font-size: 13dp; }
button { font-weight: normal; text-align: center; }
button:hover, input:hover, select:hover { background-color: #2b3340; border-color: #788596; }
button:focus, input:focus, select:focus, summary:focus { border-color: #a9c7ff; }
.disclosure { display: block; margin: 0dp 0dp 12dp 0dp; border: 0dp; border-top: 1dp #303641; background-color: transparent; }
.disclosure > summary { display: block; margin: 0dp; padding: 0dp; }
.disclosure > summary > button { display: block; width: 100%; height: auto; min-height: 32dp; margin: 0dp; padding: 6dp 0dp; text-align: left; font-weight: bold; color: #dce3ed; background-color: transparent; border: 1dp transparent; white-space: normal; }
.disclosure-body { display: block; padding: 8dp 0dp; }
button:active { background-color: #10283e; border-color: #4db6f2; }
button:disabled, input:disabled, select:disabled, .disabled { color: #657487; background-color: #111a25; border-color: #253241; }
button.primary { color: #101c30; background-color: #a9c7ff; border-color: #a9c7ff; }
button.primary:hover, button.primary:focus { color: #101c30; background-color: #c4d8ff; border-color: #e2ecff; }
button.danger { color: #ffdfe3; background-color: #5d2530; border-color: #954452; }
button.danger:hover, button.danger:focus { background-color: #7c2f3e; border-color: #e87986; }
button.ghost { color: #bdc6d2; background-color: transparent; border-color: transparent; }
button.icon { min-width: 32dp; padding-left: 8dp; padding-right: 8dp; }
button.active { color: #c4d8ff; background-color: #28384f; border-color: #6685b5; }

input[readonly], .read-only { color: #93a4b7; background-color: #111c29; border-color: #29394b; }
input:invalid, .invalid { border-color: #d85d6a; }
input[type="checkbox"], input[type="radio"] { width: 16dp; min-width: 16dp; height: 16dp; min-height: 16dp; padding: 0dp; }
input:checked, input[type="radio"]:checked { background-color: #2389c5; border-color: #72ceff; }
input[type="range"] { min-height: 30dp; padding: 7dp 3dp; background-color: transparent; border-color: transparent; }
input[type="range"] slidertrack { height: 4dp; background-color: #293b50; }
input[type="range"] sliderprogress { height: 4dp; background-color: #278fc9; }
input[type="range"] sliderbar { width: 12dp; height: 12dp; margin-top: -4dp; background-color: #72ceff; border: 2dp #13354c; }
input[type="range"] sliderbar:hover { background-color: #b4e7ff; }
input[type="range"] sliderbar:active, input[type="range"] sliderbar:focus { background-color: #ffffff; border-color: #73ccff; }
select selectvalue { padding-right: 20dp; color: #e3e7ed; }
select selectarrow { width: 16dp; color: #a9c7ff; background-color: transparent; }
select selectbox, selectbox { display: block; flex-direction: column; flex-wrap: nowrap; align-items: stretch; width: 100%; min-width: 0dp; margin-top: 2dp; color: #dce7f3; background-color: #101b29; border: 1dp #45617d; }
select selectbox option, selectbox option { display: block; flex: 0 0 auto; box-sizing: border-box; width: 100%; min-width: 100%; white-space: nowrap; }
option { display: block; box-sizing: border-box; width: 100%; padding: 8dp 10dp; }
option:hover { color: #ffffff; background-color: #1b3850; }
option:checked { color: #bdeaff; background-color: #174563; }
option:disabled { color: #566576; background-color: #111923; }

label { color: #b9c8d8; }
.field { display: flex; flex-direction: row; align-items: center; min-width: 0dp; margin-bottom: 8dp; }
.field-label { box-sizing: border-box; flex: 0 0 112dp; width: 112dp; margin: 0dp; padding-right: 12dp; color: #b6bfcc; font-size: 13dp; font-weight: normal; text-align: right; white-space: normal; }
.field-control { flex: 1 1 auto; width: auto; min-width: 0dp; margin: 0dp; }
.field-row { display: flex; flex-direction: column; align-items: stretch; gap: 8dp; min-width: 0dp; margin-bottom: 8dp; }
.field-row > .field { flex: 1 1 auto; margin: 0dp; }
.check-row { display: flex; align-items: center; min-height: 28dp; padding: 2dp 0dp 2dp 112dp; }
.check-row input { margin: 0dp 8dp 0dp 0dp; }
.range-row { display: flex; flex: 1 1 0dp; align-items: center; gap: 8dp; min-width: 0dp; }
.range-row input { flex: 1 1 0dp; width: 0dp; min-width: 0dp; margin: 0dp; }
output, .value-chip { display: inline-block; box-sizing: border-box; width: 50dp; min-width: 50dp; margin: 0dp; padding: 5dp 4dp; color: #dce6f7; background-color: #202630; border: 0dp; text-align: center; font-size: 13dp; }
.validation { margin: -4dp 0dp 6dp 0dp; padding-left: 112dp; color: #ff8994; font-size: 12dp; }
.status { color: #9eb2c6; }
.status-success { color: #72d8ae; }
.status-warning { color: #f3c979; }
.busy { opacity: .62; pointer-events: none; }
.alert { padding: 8dp 10dp; color: #ffdce1; background-color: #4a1d28f2; border: 1dp #b24b5f; }
.status-chip { min-width: 74dp; padding: 5dp 8dp; color: #a9e4c9; background-color: #10261f; border: 1dp #285c48; text-align: center; }
.wrap { white-space: normal; }

.toolbar, .command-bar, .tabs { display: flex; align-items: center; }
.toolbar { padding: 3dp; background-color: #0c1622; border: 1dp #233347; }
.toolbar button, .tabs button { min-width: 0dp; color: #aab5c4; background-color: transparent; border: 0dp; border-bottom: 2dp transparent; }
.command-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8dp; min-width: 0dp; margin-top: 16dp; padding-top: 12dp; border-top: 1dp #303641; }
.command-bar button { margin: 0dp; }
.command-bar .primary { margin-left: auto; }
.tabs { overflow-x: auto; border-bottom: 1dp #2a3a4d; }
.tabs button { min-width: 88dp; color: #8fa4ba; background-color: transparent; border-color: transparent; }
.tabs button:hover { color: #d9e8f5; background-color: #162638; }
.tabs button.active { color: #c4d8ff; background-color: #28384f; border-bottom-color: #a9c7ff; }

details { margin: 8dp 0dp; padding: 0dp; background-color: transparent; border: 0dp; }
details, summary { pointer-events: auto; }
summary { padding: 8dp; color: #cbd9e7; font-size: 13dp; font-weight: bold; letter-spacing: .5dp; background-color: #131f2d; }
details > :not(summary) { margin-left: 0dp; margin-right: 0dp; }
details > :last-child { margin-bottom: 0dp; }
.metric-list, .metric-grid, table { background-color: #0b1520; border: 1dp #243548; }
.metric-list { padding: 9dp 12dp; }
.metric { display: flex; padding: 7dp 0dp; border-bottom: 1dp #213144; }
.metric-name { flex: 1; color: #8499ae; }
.metric-value { color: #d9e7f4; font-weight: bold; }
table { width: 100%; }
th { padding: 9dp; color: #8499ae; font-size: 11dp; letter-spacing: 1dp; text-align: left; border-bottom: 1dp #2a3a4d; }
td { padding: 9dp; color: #c9d7e5; border-bottom: 1dp #1e2d3e; }
.progress, progress { height: 8dp; background-color: #253548; border: 0dp; }
.progress > div, progress fill { height: 8dp; background-color: #35a9e9; }
.file-picker { display: flex; align-items: center; }
.file-picker input { flex: 1; }
.prototype-banner { padding: 8dp 10dp; color: #f1c878; background-color: #2b2417; border: 1dp #6a5730; }
.overlay { background-color: #050912d9; }
scrollbarvertical { width: 10dp; margin: 3dp; }
scrollbarvertical slidertrack { background-color: #0b1420; }
scrollbarvertical sliderbar { min-height: 28dp; background-color: #32485e; }
scrollbarvertical sliderbar:hover { background-color: #4c6d8a; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0dp; }

/* Shared inspector patterns. Scene styles only choose placement and sizing. */
.field > .field-control { flex: 1 1 0dp; width: 0dp; }
.range-row > output { flex: 0 0 50dp; }
.range-row > button { flex: 0 0 32dp; padding: 0dp; }
.field + .hint { margin: -4dp 0dp 8dp 112dp; font-size: 12dp; }
.check-row input { flex: 0 0 16dp; }
.disclosure > summary > button:hover { background-color: #232933; }
.disclosure > summary > button:focus { border-color: #a9c7ff; }
.disclosure > summary > button[aria-expanded="true"] { color: #c4d8ff; }
.status-chip { box-sizing: border-box; font-size: 12dp; background-color: transparent; border: 0dp; }
.status-ready { color: #94d5b0; }
.status-updating { color: #a9c7ff; }
.status-error { color: #ffabb3; }
.preset-row { display: flex; flex-wrap: wrap; gap: 8dp; }
.preset-row button { flex: 1 1 64dp; }
.wide { width: 100%; margin: 8dp 0dp 0dp 0dp; }
.player-controls { display: flex; justify-content: center; gap: 4dp; margin: 4dp 0dp; }
.player-controls button { flex: 0 0 32dp; }
.list-row, .gene, .bone { padding: 8dp 0dp; border-bottom: 1dp #303641; }
.gene-heading { display: flex; align-items: center; gap: 8dp; margin-bottom: 4dp; font-size: 13dp; }
.gene-heading span:first-child { flex: 1; }
.override { color: #e6bf80; font-size: 12dp; }
.bone { display: flex; gap: 8dp; font-size: 13dp; }
.bone span { flex: 1; }
.bone span + span { color: #aab5c4; text-align: right; }
.readout { margin: 8dp 0dp; padding: 8dp; color: #b6bfcc; background-color: #202630; font-size: 13dp; white-space: normal; }
.readout output { width: auto; min-width: 0dp; padding: 0dp; background-color: transparent; }
.diagnostics .readout { white-space: pre-wrap; }
.error { color: #ffabb3; font-size: 13dp; }
